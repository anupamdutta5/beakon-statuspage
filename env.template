# Status Page Environment Variables Template
# Copy this file to .env and fill in your actual values
# This file contains all configuration options with no hardcoded values

# ===========================================
# Server Configuration
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s

# TLS Configuration (optional)
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=statuspage
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_POOL_SIZE=10

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your_jwt_secret_key_here_must_be_secure
JWT_EXPIRES_IN=24h
JWT_REFRESH_IN=168h
JWT_ISSUER=statuspage
JWT_AUDIENCE=statuspage-api

# ===========================================
# Email Configuration
# ===========================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# SendGrid Configuration (alternative to SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM=noreply@yourdomain.com

# ===========================================
# Payment Configuration
# ===========================================
PAYMENT_DEFAULT_PROVIDER=stripe

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_SANDBOX=true

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# PayU Configuration
PAYU_MERCHANT_KEY=your_payu_merchant_key_here
PAYU_MERCHANT_SALT=your_payu_merchant_salt_here
PAYU_AUTH_HEADER=your_payu_auth_header_here

# ===========================================
# Monitoring Configuration
# ===========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_SERVICE_NAME=statuspage

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=statuspage
INFLUX_BUCKET=metrics

# ===========================================
# Security Configuration
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE=100
RATE_LIMIT_BURST=200
RATE_LIMIT_WINDOW=1m

ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_ALGORITHM=AES-256-GCM

SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=24h
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# Service Discovery Configuration
# ===========================================
SERVICE_DISCOVERY_PROVIDER=consul
CONSUL_ADDR=localhost:8500
CONSUL_TOKEN=your_consul_token_here
CONSUL_DC=dc1

# ===========================================
# Kafka Configuration
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INCIDENTS=incidents
KAFKA_TOPIC_NOTIFICATIONS=notifications
KAFKA_TOPIC_ANALYTICS=analytics
KAFKA_TOPIC_PAYMENTS=payments

# ===========================================
# Tracing Configuration
# ===========================================
TRACING_ENABLED=true
TRACING_SERVICE_NAME=statuspage
TRACING_ENDPOINT=http://localhost:14268/api/traces
TRACING_SAMPLE_RATE=0.1

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILENAME=
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# ===========================================
# Environment
# ===========================================
ENVIRONMENT=development

# ===========================================
# Third-party Integrations
# ===========================================

# Slack Integration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# PagerDuty Integration
PAGERDUTY_API_KEY=your_pagerduty_api_key_here
PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key_here

# Opsgenie Integration
OPSGENIE_API_KEY=your_opsgenie_api_key_here

# Datadog Integration
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here

# New Relic Integration
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# Twilio Integration (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ===========================================
# Feature Flags
# ===========================================
FEATURE_ANALYTICS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_INTEGRATIONS_ENABLED=true
FEATURE_CUSTOM_DOMAINS_ENABLED=true
FEATURE_SSL_MANAGEMENT_ENABLED=true
FEATURE_TWO_FACTOR_AUTH_ENABLED=false
FEATURE_SSO_ENABLED=false

# ===========================================
# Performance Configuration
# ===========================================
CACHE_TTL=300s
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=600s

# Database Connection Pool
DB_CONNECTION_TIMEOUT=30s
DB_QUERY_TIMEOUT=10s
DB_IDLE_TIMEOUT=300s

# ===========================================
# Development/Testing Configuration
# ===========================================
DEBUG_MODE=false
MOCK_EXTERNAL_SERVICES=false
TEST_DATABASE_URL=postgres://test:test@localhost:5432/statuspage_test
TEST_REDIS_URL=redis://localhost:6379/1

# ===========================================
# Kubernetes/Container Configuration
# ===========================================
KUBERNETES_NAMESPACE=statuspage
POD_NAME=
NODE_NAME=
CLUSTER_NAME=statuspage-cluster

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your_backup_s3_bucket_here
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_backup_s3_access_key_here
BACKUP_S3_SECRET_KEY=your_backup_s3_secret_key_here
