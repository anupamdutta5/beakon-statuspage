# StatusPage Environment Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password

# Database Names for each service
DB_NAME_TENANT=statuspage_tenant
DB_NAME_INCIDENT=statuspage_incident
DB_NAME_NOTIFICATION=statuspage_notification
DB_NAME_ANALYTICS=statuspage_analytics
DB_NAME_MONITORING=statuspage_monitoring
DB_NAME_BRANDING=statuspage_branding
DB_NAME_DATABASE=statuspage_database
DB_NAME_EVENT_STORE=statuspage_event_store
DB_NAME_SAAS_ADMIN=statuspage_saas_admin
DB_NAME_TENANT_ADMIN=statuspage_tenant_admin
DB_NAME_USER=statuspage_user
DB_NAME_COMPONENT=statuspage_component
DB_NAME_PAYMENT=statuspage_payment
DB_NAME_LANDING=statuspage_landing

# Consumer Database Names
DB_NAME_ANALYTICS_CONSUMER=statuspage_analytics_consumer
DB_NAME_AUDIT_CONSUMER=statuspage_audit_consumer
DB_NAME_BILLING_CONSUMER=statuspage_billing_consumer
DB_NAME_NOTIFICATION_CONSUMER=statuspage_notification_consumer

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID_PREFIX=statuspage

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24
JWT_ISSUER=statuspage

# =============================================================================
# SERVICE PORTS
# =============================================================================
# Core Services
PORT_API_GATEWAY=8080
PORT_DATABASE_SERVICE=8090
PORT_EVENT_STORE_SERVICE=8091
PORT_SAAS_ADMIN_SERVICE=8092
PORT_TENANT_SERVICE=8093
PORT_INCIDENT_SERVICE=8094
PORT_NOTIFICATION_SERVICE=8095
PORT_ANALYTICS_SERVICE=8096
PORT_MONITORING_SERVICE=8097
PORT_BRANDING_SERVICE=8098
PORT_TENANT_ADMIN_SERVICE=8099
PORT_LANDING_PAGE_SERVICE=8100

# Additional Services
PORT_USER_SERVICE=8001
PORT_COMPONENT_SERVICE=8002
PORT_PAYMENT_SERVICE=8003

# =============================================================================
# SERVICE URLS (for inter-service communication)
# =============================================================================
DATABASE_SERVICE_URL=http://localhost:8090
EVENT_STORE_SERVICE_URL=http://localhost:8091
SAAS_ADMIN_SERVICE_URL=http://localhost:8092
TENANT_SERVICE_URL=http://localhost:8093
INCIDENT_SERVICE_URL=http://localhost:8094
NOTIFICATION_SERVICE_URL=http://localhost:8095
ANALYTICS_SERVICE_URL=http://localhost:8096
MONITORING_SERVICE_URL=http://localhost:8097
BRANDING_SERVICE_URL=http://localhost:8098
TENANT_ADMIN_SERVICE_URL=http://localhost:8099
LANDING_PAGE_SERVICE_URL=http://localhost:8100
USER_SERVICE_URL=http://localhost:8001
COMPONENT_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://localhost:8003

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@statuspage.com

# SendGrid (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@statuspage.com

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Jaeger (Tracing)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# SECURITY
# =============================================================================
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# FILE STORAGE
# =============================================================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=statuspage-assets

# Local Storage
LOCAL_STORAGE_PATH=./uploads

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key

# Datadog
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
# Hot Reload
HOT_RELOAD=true

# Debug Mode
DEBUG=true

# Test Data
LOAD_TEST_DATA=true

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================
# SSL/TLS
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Health Checks
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30s
