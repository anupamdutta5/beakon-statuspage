# Beakon Status Page - Environment Variables Template
# Copy this file to .env and fill in the actual values

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Configuration
JWT_SECRET=your-strong-jwt-secret-here-min-32-chars
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=statuspage_user
DB_PASSWORD=your-secure-database-password
DB_NAME=statuspage_management
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# ============================================================================
# EXTERNAL SERVICE CONFIGURATION
# ============================================================================

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Beakon Status Page

# SMTP Configuration (Alternative to SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateways
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Jaeger Tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_SERVICE_NAME=beakon-service
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token
INFLUX_ORG=beakon
INFLUX_BUCKET=metrics

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL=info
LOG_FORMAT=json

# API Gateway
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_TIMEOUT=30s
API_GATEWAY_RATE_LIMIT=100

# Service Discovery
CONSUL_ADDR=localhost:8500
CONSUL_TOKEN=your-consul-token

# Service URLs (for inter-service communication)
COMPONENT_SERVICE_URL=http://component-service:8001
INCIDENT_SERVICE_URL=http://incident-service:8002
MONITORING_SERVICE_URL=http://monitoring-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
BRANDING_SERVICE_URL=http://branding-service:8005

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-Correlation-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10
RATE_LIMIT_REDIS_KEY_PREFIX=rate_limit:

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_METRICS_ENABLED=true
FEATURE_TRACING_ENABLED=true
FEATURE_CACHE_ENABLED=true
FEATURE_RATE_LIMITING_ENABLED=true
FEATURE_CIRCUIT_BREAKER_ENABLED=true

# ============================================================================
# CIRCUIT BREAKER CONFIGURATION
# ============================================================================

CIRCUIT_BREAKER_TIMEOUT=60s
CIRCUIT_BREAKER_MAX_REQUESTS=3
CIRCUIT_BREAKER_INTERVAL=10s
CIRCUIT_BREAKER_RATIO=0.6

# ============================================================================
# RETRY CONFIGURATION
# ============================================================================

RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_INTERVAL=1s
RETRY_MAX_INTERVAL=30s
RETRY_MULTIPLIER=2
RETRY_JITTER=true