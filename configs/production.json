{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "300s",
    "tls": {
      "enabled": true,
      "cert_file": "/etc/ssl/certs/statuspage.crt",
      "key_file": "/etc/ssl/private/statuspage.key"
    }
  },
  "database": {
    "host": "postgres-service",
    "port": 5432,
    "user": "statuspage_user",
    "password": "",
    "name": "statuspage_prod",
    "ssl_mode": "require",
    "max_conns": 100,
    "min_conns": 10
  },
  "redis": {
    "host": "redis-service",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 50
  },
  "jwt": {
    "secret": "",
    "expires_in": "1h",
    "refresh_in": "24h",
    "issuer": "statuspage.io",
    "audience": "statuspage-api"
  },
  "email": {
    "provider": "sendgrid",
    "smtp": {
      "host": "smtp.sendgrid.net",
      "port": 587,
      "username": "apikey",
      "password": "",
      "from": "noreply@statuspage.io",
      "use_tls": true
    },
    "sendgrid": {
      "api_key": "",
      "from": "noreply@statuspage.io"
    }
  },
  "payment": {
    "default_provider": "stripe",
    "providers": {
      "stripe": {
        "secret_key": "",
        "webhook_secret": "",
        "publishable_key": ""
      },
      "paypal": {
        "client_id": "",
        "client_secret": "",
        "sandbox": false
      }
    }
  },
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "port": 9090,
      "path": "/metrics"
    },
    "jaeger": {
      "enabled": true,
      "endpoint": "http://jaeger-collector:14268/api/traces",
      "service_name": "statuspage"
    },
    "influxdb": {
      "url": "http://influxdb:8086",
      "token": "",
      "org": "statuspage",
      "bucket": "metrics"
    }
  },
  "security": {
    "rate_limit": {
      "enabled": true,
      "rate": 1000,
      "burst": 2000,
      "window": "1m"
    },
    "cors": {
      "allowed_origins": ["https://statuspage.io", "https://app.statuspage.io"],
      "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowed_headers": ["Authorization", "Content-Type", "X-Requested-With"],
      "allow_credentials": true
    },
    "encryption": {
      "key": "",
      "algorithm": "AES-256-GCM"
    },
    "session": {
      "secret": "",
      "max_age": "1h",
      "secure": true,
      "http_only": true,
      "same_site": "Strict"
    }
  },
  "service_discovery": {
    "provider": "consul",
    "consul": {
      "address": "consul:8500",
      "token": "",
      "dc": "dc1"
    }
  },
  "kafka": {
    "brokers": ["kafka:9092"],
    "topics": {
      "incidents": "incidents",
      "notifications": "notifications",
      "analytics": "analytics",
      "payments": "payments"
    }
  },
  "tracing": {
    "enabled": true,
    "service_name": "statuspage",
    "endpoint": "http://jaeger-collector:14268/api/traces",
    "sample_rate": 0.1
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "filename": "",
    "max_size": 100,
    "max_backups": 10,
    "max_age": 30,
    "compress": true
  },
  "environment": "production"
}
