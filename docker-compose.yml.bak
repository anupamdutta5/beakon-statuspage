# Beakon Platform - Complete System
# All microservices + infrastructure
version: '3.8'

services:
  # ===========================================
  # INFRASTRUCTURE
  # ===========================================
  postgres:
    image: postgres:16-alpine
    container_name: beakon-postgres
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB=postgres
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - beakon-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7-alpine
    container_name: beakon-redis
    ports:
      - "6379:6379"
    command: redis-server --appendonly yes --maxmemory 512mb --maxmemory-policy allkeys-lru
    volumes:
      - redis-data:/data
    networks:
      - beakon-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  rabbitmq:
    image: rabbitmq:3.12-management-alpine
    container_name: beakon-rabbitmq
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=guest
      - RABBITMQ_DEFAULT_PASS=guest
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    networks:
      - beakon-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s

  # ===========================================
  # BACKEND SERVICES
  # ===========================================

  # User Service - Port 8081
  user-service:
    build:
      context: ./microservices
      dockerfile: user-service/build/Dockerfile
    container_name: beakon-user-service
    ports:
      - "8081:8081"
      - "9091:9091"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8081
      - DB_NAME=statuspage_user
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Component Service - Port 8084
  component-service:
    build:
      context: ./microservices
      dockerfile: component-service/build/Dockerfile
    container_name: beakon-component-service
    ports:
      - "8084:8084"
      - "9094:9094"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8084
      - DB_NAME=statuspage_component
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Notification Service - Port 8085
  notification-service:
    build:
      context: ./microservices/notification-service
      dockerfile: build/Dockerfile
    container_name: beakon-notification-service
    ports:
      - "8085:8085"
      - "9095:9095"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8085
      - DB_NAME=statuspage_notification
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Incident Service - Port 8086
  incident-service:
    build:
      context: ./microservices/incident-service
      dockerfile: build/Dockerfile
    container_name: beakon-incident-service
    ports:
      - "8086:8086"
      - "9096:9096"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8086
      - DB_NAME=statuspage_incident
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Payment Service - Port 8088
  payment-service:
    build:
      context: ./microservices/payment-service
      dockerfile: build/Dockerfile
    container_name: beakon-payment-service
    ports:
      - "8088:8088"
      - "9098:9098"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8088
      - DB_NAME=statuspage_payment
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Analytics Service - Port 8090
  analytics-service:
    build:
      context: ./microservices/analytics-service
      dockerfile: build/Dockerfile
    container_name: beakon-analytics-service
    ports:
      - "8090:8090"
      - "9100:9100"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8090
      - DB_NAME=statuspage_analytics
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Monitoring Service - Port 8092
  monitoring-service:
    build:
      context: ./microservices/monitoring-service
      dockerfile: build/Dockerfile
    container_name: beakon-monitoring-service
    ports:
      - "8092:8092"
      - "9102:9102"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8092
      - DB_NAME=monitoring_db
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Status UI Service - Port 8093
  status-ui-service:
    build:
      context: ./microservices/status-ui-service
      dockerfile: build/Dockerfile
    container_name: beakon-status-ui-service
    ports:
      - "8093:8093"
      - "9103:9103"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8093
    networks:
      - beakon-network
    restart: unless-stopped

  # Event Store Service - Port 8096
  event-store-service:
    build:
      context: ./microservices/event-store-service
      dockerfile: build/Dockerfile
    container_name: beakon-event-store-service
    ports:
      - "8096:8096"
      - "9106:9106"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8096
      - DB_NAME=statuspage_event_store
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Branding Service - Port 8097
  branding-service:
    build:
      context: ./microservices/branding-service
      dockerfile: build/Dockerfile
    container_name: beakon-branding-service
    ports:
      - "8097:8097"
      - "9107:9107"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8097
      - DB_NAME=statuspage_branding
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # SaaS Admin Service - Port 8098
  saas-admin-service:
    build:
      context: ./microservices/saas-admin-service
      dockerfile: build/Dockerfile
    container_name: beakon-saas-admin-service
    ports:
      - "8098:8098"
      - "9108:9108"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8098
      - DB_NAME=saas_admin
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Tenant Admin Service - Port 8099
  tenant-admin-service:
    build:
      context: ./microservices
      dockerfile: tenant-admin-service/build/Dockerfile
    container_name: beakon-tenant-admin-service
    ports:
      - "8099:8099"
      - "9109:9109"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8099
      - DB_NAME=tenant_admin_db
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # Landing Page Service - Port 8100
  landing-page-service:
    build:
      context: ./microservices/landing-page-service
      dockerfile: build/Dockerfile
    container_name: beakon-landing-page-service
    ports:
      - "8100:8100"
      - "9110:9110"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8100
      - DB_NAME=statuspage_landing
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
    restart: unless-stopped

  # API Gateway - Port 8080 (Entry Point)
  api-gateway:
    build:
      context: ./microservices/api-gateway
      dockerfile: build/Dockerfile
    container_name: beakon-api-gateway
    ports:
      - "8080:8080"
      - "9090:9090"
    env_file:
      - .env
    environment:
      - SERVER_PORT=8080
      - USER_SERVICE_URL=http://user-service:8081
      - COMPONENT_SERVICE_URL=http://component-service:8084
      - NOTIFICATION_SERVICE_URL=http://notification-service:8085
      - INCIDENT_SERVICE_URL=http://incident-service:8086
      - PAYMENT_SERVICE_URL=http://payment-service:8088
      - ANALYTICS_SERVICE_URL=http://analytics-service:8090
      - MONITORING_SERVICE_URL=http://monitoring-service:8092
      - STATUS_UI_SERVICE_URL=http://status-ui-service:8093
      - EVENT_STORE_SERVICE_URL=http://event-store-service:8096
      - BRANDING_SERVICE_URL=http://branding-service:8097
      - SAAS_ADMIN_SERVICE_URL=http://saas-admin-service:8098
      - TENANT_ADMIN_SERVICE_URL=http://tenant-admin-service:8099
      - LANDING_PAGE_SERVICE_URL=http://landing-page-service:8100
    networks:
      - beakon-network
    depends_on:
      - user-service
      - tenant-admin-service
    restart: unless-stopped

  # ===========================================
  # FRONTEND SERVICES
  # ===========================================

  # SaaS Admin Frontend - Port 3001
  saas-admin-frontend:
    build:
      context: ./microservices/saas-admin-frontend
      dockerfile: build/Dockerfile
    container_name: beakon-saas-admin-frontend
    ports:
      - "3001:3001"
    environment:
      - NODE_ENV=production
      - PORT=3001
      - NEXT_PUBLIC_API_URL=http://localhost:8098
    networks:
      - beakon-network
    depends_on:
      - saas-admin-service
    restart: unless-stopped

  # Tenant Admin Frontend - Port 3002
  tenant-admin-frontend:
    build:
      context: ./microservices/tenant-admin-frontend
      dockerfile: build/Dockerfile
    container_name: beakon-tenant-admin-frontend
    ports:
      - "3002:3002"
    environment:
      - NODE_ENV=production
      - PORT=3002
      - NEXT_PUBLIC_API_URL=
    networks:
      - beakon-network
    depends_on:
      - tenant-admin-service
    restart: unless-stopped

  # ===========================================
  # CONSUMER SERVICES (Background Workers)
  # ===========================================

  analytics-consumer:
    build:
      context: ./microservices/analytics-consumer
      dockerfile: build/Dockerfile
    container_name: beakon-analytics-consumer
    env_file:
      - .env
    environment:
      - DB_NAME=statuspage_analytics_consumer
      - RABBITMQ_QUEUE=analytics_events
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped

  notification-consumer:
    build:
      context: ./microservices/notification-consumer
      dockerfile: build/Dockerfile
    container_name: beakon-notification-consumer
    env_file:
      - .env
    environment:
      - DB_NAME=statuspage_notification_consumer
      - RABBITMQ_QUEUE=notification_events
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped

  audit-consumer:
    build:
      context: ./microservices/audit-consumer
      dockerfile: build/Dockerfile
    container_name: beakon-audit-consumer
    env_file:
      - .env
    environment:
      - DB_NAME=statuspage_audit_consumer
      - RABBITMQ_QUEUE=audit_events
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped

  billing-consumer:
    build:
      context: ./microservices/billing-consumer
      dockerfile: build/Dockerfile
    container_name: beakon-billing-consumer
    env_file:
      - .env
    environment:
      - DB_NAME=statuspage_billing_consumer
      - RABBITMQ_QUEUE=billing_events
    networks:
      - beakon-network
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
    restart: unless-stopped

networks:
  beakon-network:
    name: beakon-network
    driver: bridge

volumes:
  postgres-data:
    name: beakon-postgres-data
  redis-data:
    name: beakon-redis-data
  rabbitmq-data:
    name: beakon-rabbitmq-data
