# Environment: development
ENVIRONMENT=development

# Database
DB_HOST=statuspage-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Redis
REDIS_HOST=beakon-redis
REDIS_PORT=6379
REDIS_ENABLED=true

# RabbitMQ
RABBITMQ_HOST=beakon-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=dev-secret-for-testing-only-change-in-production-min-32-chars

# Logging
LOG_LEVEL=info
REDIS_PASSWORD=
