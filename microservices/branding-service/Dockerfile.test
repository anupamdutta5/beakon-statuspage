# Multi-stage Dockerfile for Branding Service Testing
FROM golang:1.21-alpine AS builder

# Install dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main cmd/main.go

# Test stage
FROM golang:1.21-alpine AS test

# Install dependencies
RUN apk add --no-cache git make postgresql-client

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Install test dependencies
RUN go install github.com/stretchr/testify/assert@latest
RUN go install github.com/stretchr/testify/require@latest

# Set environment variables for testing
ENV ENVIRONMENT=testing
ENV DB_HOST=postgres
ENV DB_PORT=5432
ENV DB_NAME=statuspage_branding_test
ENV DB_USER=postgres
ENV DB_PASSWORD=postgres
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV SERVER_PORT=8089
ENV FILE_STORAGE_TYPE=local
ENV FILE_STORAGE_LOCAL_PATH=/app/uploads
ENV MAX_FILE_SIZE=10MB

# Create uploads directory
RUN mkdir -p /app/uploads

# Default command runs tests
CMD ["go", "test", "-v", "./tests/...", "-coverprofile=coverage.out"]

