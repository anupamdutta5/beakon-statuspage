# Environment Configuration Template
# Copy this file to .env and fill in the actual values
# NEVER commit the .env file to version control

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Configuration - MUST be changed in production
JWT_SECRET=<generate-secure-secret-here>
JWT_EXPIRATION=24
JWT_ISSUER=statuspage-service

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<secure-database-password>
DB_NAME=statuspage_db
DB_SSL_MODE=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=10

# Service Configuration
SERVICE_NAME=service-name
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=Service Description

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090
HEALTH_PORT=8081
LOG_LEVEL=info

# Server Timeouts
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=120

# Redis Configuration (if applicable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

# Kafka Configuration (if applicable)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=service-group
KAFKA_CLIENT_ID=service-client

# Instructions for generating secure secrets:
# JWT_SECRET: openssl rand -base64 32
# DB_PASSWORD: openssl rand -base64 16
# Store production secrets in a secure vault (HashiCorp Vault, AWS Secrets Manager, etc.)