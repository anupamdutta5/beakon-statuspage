{
  "environment": "testing",
  "log_level": "debug",
  "timeout": "10m",
  "retry_attempts": 5,
  "retry_delay": "2s",
  "cleanup_on_exit": true,
  "parallel_tests": false,
  "coverage_report": true,
  "test_data_dir": "./testdata",
  "server": {
    "port": "8087",
    "host": "localhost",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "statuspage_monitoring_test",
    "user": "postgres",
    "password": "postgres",
    "ssl_mode": "disable",
    "max_connections": 10,
    "max_idle_connections": 5,
    "connection_max_lifetime": "1h"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 10,
    "min_idle_connections": 5
  },
  "services": {
    "tenant_service": {
      "base_url": "http://localhost:8082",
      "timeout": "5s"
    },
    "component_service": {
      "base_url": "http://localhost:8084",
      "timeout": "5s"
    },
    "incident_service": {
      "base_url": "http://localhost:8085",
      "timeout": "5s"
    }
  },
  "test_scenarios": {
    "create_monitor": {
      "enabled": true,
      "timeout": "5s"
    },
    "update_monitor": {
      "enabled": true,
      "timeout": "5s"
    },
    "delete_monitor": {
      "enabled": true,
      "timeout": "5s"
    },
    "list_monitors": {
      "enabled": true,
      "timeout": "5s"
    },
    "start_monitor": {
      "enabled": true,
      "timeout": "5s"
    },
    "stop_monitor": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_monitor_results": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_monitor_stats": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_monitors_by_component": {
      "enabled": true,
      "timeout": "5s"
    },
    "performance_test": {
      "enabled": true,
      "timeout": "10s",
      "bulk_operations": 20
    }
  },
  "mock_data": {
    "monitors": [
      {
        "tenant_id": "test-tenant-id",
        "component_id": "test-component-id",
        "name": "API Health Check",
        "type": "http",
        "url": "https://api.example.com/health",
        "method": "GET",
        "interval": 60,
        "timeout": 30,
        "status": "active",
        "settings": {
          "expected_status": 200,
          "expected_body": "ok"
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "component_id": "test-component-id",
        "name": "Database Ping",
        "type": "ping",
        "url": "8.8.8.8",
        "interval": 30,
        "timeout": 10,
        "status": "active"
      },
      {
        "tenant_id": "test-tenant-id",
        "component_id": "test-component-id",
        "name": "SSL Certificate Check",
        "type": "tcp",
        "url": "api.example.com:443",
        "interval": 300,
        "timeout": 30,
        "status": "active"
      }
    ],
    "monitor_types": [
      "http",
      "https",
      "ping",
      "tcp",
      "udp",
      "dns",
      "ssl"
    ],
    "monitor_statuses": [
      "active",
      "paused",
      "disabled"
    ],
    "result_statuses": [
      "up",
      "down",
      "unknown"
    ]
  }
}

