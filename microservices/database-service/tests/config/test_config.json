{
  "environment": "testing",
  "log_level": "debug",
  "timeout": "10m",
  "retry_attempts": 5,
  "retry_delay": "2s",
  "cleanup_on_exit": true,
  "parallel_tests": false,
  "coverage_report": true,
  "test_data_dir": "./testdata",
  "server": {
    "port": "8089",
    "host": "localhost",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "statuspage_database_test",
    "user": "postgres",
    "password": "postgres",
    "ssl_mode": "disable",
    "max_connections": 10,
    "max_idle_connections": 5,
    "connection_max_lifetime": "1h"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 10,
    "min_idle_connections": 5
  },
  "services": {
    "tenant_service": {
      "base_url": "http://localhost:8082",
      "timeout": "5s"
    }
  },
  "test_scenarios": {
    "create_record": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_record": {
      "enabled": true,
      "timeout": "5s"
    },
    "update_record": {
      "enabled": true,
      "timeout": "5s"
    },
    "delete_record": {
      "enabled": true,
      "timeout": "5s"
    },
    "list_records": {
      "enabled": true,
      "timeout": "5s"
    },
    "query_records": {
      "enabled": true,
      "timeout": "5s"
    },
    "execute_query": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_table_schema": {
      "enabled": true,
      "timeout": "5s"
    },
    "backup_database": {
      "enabled": true,
      "timeout": "10s"
    },
    "get_database_stats": {
      "enabled": true,
      "timeout": "5s"
    },
    "performance_test": {
      "enabled": true,
      "timeout": "10s",
      "bulk_operations": 25
    }
  },
  "mock_data": {
    "records": [
      {
        "tenant_id": "test-tenant-id",
        "table": "test_table",
        "data": {
          "name": "Test Record",
          "value": 123,
          "active": true
        },
        "metadata": {
          "created_by": "test-user"
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "table": "users",
        "data": {
          "name": "John Doe",
          "email": "john@example.com",
          "age": 30
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "table": "products",
        "data": {
          "name": "Test Product",
          "price": 99.99,
          "category": "electronics"
        }
      }
    ],
    "table_schemas": [
      {
        "tenant_id": "test-tenant-id",
        "table": "users",
        "columns": {
          "id": "VARCHAR(255) PRIMARY KEY",
          "name": "VARCHAR(255) NOT NULL",
          "email": "VARCHAR(255) UNIQUE",
          "age": "INTEGER"
        },
        "indexes": [
          "CREATE INDEX idx_name ON users(name)",
          "CREATE INDEX idx_email ON users(email)"
        ]
      },
      {
        "tenant_id": "test-tenant-id",
        "table": "products",
        "columns": {
          "id": "VARCHAR(255) PRIMARY KEY",
          "name": "VARCHAR(255) NOT NULL",
          "price": "DECIMAL(10,2)",
          "category": "VARCHAR(100)"
        },
        "indexes": [
          "CREATE INDEX idx_category ON products(category)"
        ]
      }
    ],
    "query_examples": [
      {
        "description": "Select all users",
        "sql": "SELECT * FROM users",
        "params": []
      },
      {
        "description": "Select user by name",
        "sql": "SELECT * FROM users WHERE name = ?",
        "params": ["John Doe"]
      },
      {
        "description": "Select products by category",
        "sql": "SELECT * FROM products WHERE category = ?",
        "params": ["electronics"]
      }
    ],
    "backup_formats": [
      "json",
      "csv",
      "sql"
    ]
  }
}

