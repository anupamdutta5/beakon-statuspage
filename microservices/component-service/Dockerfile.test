# Multi-stage Dockerfile for Component Service Testing
FROM golang:1.25.0-alpine AS builder

# Install dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Install test dependencies
RUN go mod tidy && go mod download
# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main cmd/main.go

# Test stage
FROM golang:1.25.0-alpine AS test

# Install dependencies
RUN apk add --no-cache git make postgresql-client

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Install test dependencies
RUN go mod tidy && go mod download
# Install test dependencies

# Set environment variables for testing
ENV ENVIRONMENT=testing
ENV SERVER_PORT=8084
ENV DB_HOST=postgres
ENV DB_PORT=5432
ENV DB_NAME=statuspage_component_test
ENV DB_USER=postgres
ENV DB_PASSWORD=postgres
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379

# Expose port
EXPOSE 8084

# Default command runs tests
CMD ["go", "test", "-v", "./tests/...", "-coverprofile=coverage.out"]

