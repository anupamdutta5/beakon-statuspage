        "metadata": {
          "version": "1.0.0",
          "region": "us-east-1"
        }
      },
      {
        "name": "Database",
        "description": "Primary database",
        "status": "operational",
        "category": "Database",
        "tenant_id": "test-tenant-id",
        "metadata": {
          "version": "13.0",
          "region": "us-east-1"
        }
      },
      {
        "name": "CDN",
        "description": "Content delivery network",
        "status": "operational",
        "category": "CDN",
        "tenant_id": "test-tenant-id",
        "metadata": {
          "provider": "cloudflare",
          "region": "global"
        }
      }
    ],
    "statuses": [
      "operational",
      "degraded_performance",
      "partial_outage",
      "major_outage",
      "maintenance"
    ],
    "categories": [
      "API",
