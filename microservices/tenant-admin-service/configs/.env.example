# Tenant Admin Service Environment Variables Template
# Copy this file to .env and fill in your actual secrets

# Environment
ENVIRONMENT=development

# Database secrets
DB_HOST=localhost
DB_PASSWORD=your-secure-database-password
DB_SSL_MODE=disable

# JWT secret (MUST be at least 32 characters)
JWT_SECRET=your-very-long-secure-jwt-secret-minimum-32-characters-required

# Redis configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PASSWORD=your-redis-password

# RabbitMQ secrets
RABBITMQ_HOST=localhost
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your-rabbitmq-password

# Frontend URLs
FRONTEND_URL=http://localhost:3002
SAAS_ADMIN_URL=http://localhost:3001

# Service URLs (optional - defaults are in service-endpoints.yml)
# COMPONENT_SERVICE_URL=http://component-service:8084
# INCIDENT_SERVICE_URL=http://incident-service:8086
# NOTIFICATION_SERVICE_URL=http://notification-service:8085
# SUBSCRIBER_SERVICE_URL=http://subscriber-service:8087
# BRANDING_SERVICE_URL=http://branding-service:8097

# Logging
LOG_LEVEL=debug
