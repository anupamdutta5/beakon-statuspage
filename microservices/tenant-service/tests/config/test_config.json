{
  "environment": "testing",
  "log_level": "debug",
  "timeout": "10m",
  "retry_attempts": 5,
  "retry_delay": "2s",
  "cleanup_on_exit": true,
  "parallel_tests": false,
  "coverage_report": true,
  "test_data_dir": "./testdata",
  "server": {
    "port": "8082",
    "host": "localhost",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "statuspage_tenant_test",
    "user": "postgres",
    "password": "postgres",
    "ssl_mode": "disable",
    "max_connections": 10,
    "max_idle_connections": 5,
    "connection_max_lifetime": "1h"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 10,
    "min_idle_connections": 5
  },
  "services": {
    "user_service": {
      "base_url": "http://localhost:8081",
      "timeout": "5s"
    },
    "component_service": {
      "base_url": "http://localhost:8084",
      "timeout": "5s"
    },
    "incident_service": {
      "base_url": "http://localhost:8085",
      "timeout": "5s"
    }
  },
  "test_scenarios": {
    "create_tenant": {
      "enabled": true,
      "timeout": "5s"
    },
    "update_tenant": {
      "enabled": true,
      "timeout": "5s"
    },
    "delete_tenant": {
      "enabled": true,
      "timeout": "5s"
    },
    "list_tenants": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_tenant_by_subdomain": {
      "enabled": true,
      "timeout": "5s"
    },
    "update_tenant_settings": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_tenant_stats": {
      "enabled": true,
      "timeout": "5s"
    },
    "performance_test": {
      "enabled": true,
      "timeout": "10s",
      "bulk_operations": 20
    }
  },
  "mock_data": {
    "tenants": [
      {
        "name": "Test Company 1",
        "subdomain": "testcompany1",
        "domain": "testcompany1.com",
        "settings": {
          "theme": "light",
          "logo": "https://example.com/logo1.png"
        }
      },
      {
        "name": "Test Company 2",
        "subdomain": "testcompany2",
        "domain": "testcompany2.com",
        "settings": {
          "theme": "dark",
          "logo": "https://example.com/logo2.png"
        }
      }
    ]
  }
}

