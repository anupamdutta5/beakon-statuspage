#!/bin/bash
#
# Database Initialization Script for Beakon Microservices
# This script initializes all databases and runs migrations for a fresh RDS instance
#
# Usage:
#   Development: ./init-databases.sh
#   Production:  DB_HOST=rds-endpoint DB_USER=admin DB_PASSWORD=secret ./init-databases.sh
#

set -e  # Exit on error

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Configuration
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-5432}"
DB_USER="${DB_USER:-postgres}"
DB_PASSWORD="${DB_PASSWORD:-postgres}"
DB_SSLMODE="${DB_SSLMODE:-disable}"

echo -e "${GREEN}=== Beakon Database Initialization ===${NC}"
echo "Host: $DB_HOST"
echo "Port: $DB_PORT"
echo "User: $DB_USER"
echo ""

# Database configurations (parallel arrays for bash 3.2 compatibility)
DB_NAMES=("statuspage_landing" "saas_admin" "tenant_admin_db")
SERVICE_DIRS=("landing-page-service" "saas-admin-service" "tenant-admin-service")

# Function to create database if it doesn't exist
create_database() {
    local db_name=$1
    echo -e "${YELLOW}Checking database: $db_name${NC}"

    # Check if database exists
    DB_EXISTS=$(PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='$db_name'")

    if [ "$DB_EXISTS" = "1" ]; then
        echo -e "${GREEN}✓ Database $db_name already exists${NC}"
    else
        echo -e "${YELLOW}Creating database: $db_name${NC}"
        PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d postgres -c "CREATE DATABASE $db_name;"
        echo -e "${GREEN}✓ Database $db_name created${NC}"
    fi
}

# Function to run migrations
run_migrations() {
    local db_name=$1
    local service_dir=$2

    echo -e "${YELLOW}Running migrations for: $db_name${NC}"

    local migrations_dir="$service_dir/migrations"

    if [ ! -d "$migrations_dir" ]; then
        echo -e "${RED}✗ Migrations directory not found: $migrations_dir${NC}"
        return 1
    fi

    # Count migration files
    local migration_count=$(find "$migrations_dir" -name "*.sql" -type f | wc -l | tr -d ' ')

    if [ "$migration_count" -eq 0 ]; then
        echo -e "${YELLOW}⚠ No migration files found in $migrations_dir${NC}"
        return 0
    fi

    echo -e "${YELLOW}Found $migration_count migration file(s)${NC}"

    # Run each migration file in order
    for migration_file in $(ls -1 $migrations_dir/*.sql 2>/dev/null | sort); do
        echo -e "${YELLOW}  Applying: $(basename $migration_file)${NC}"
        PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $db_name -f "$migration_file" -v ON_ERROR_STOP=1

        if [ $? -eq 0 ]; then
            echo -e "${GREEN}  ✓ Applied successfully${NC}"
        else
            echo -e "${RED}  ✗ Migration failed${NC}"
            return 1
        fi
    done

    echo -e "${GREEN}✓ All migrations applied for $db_name${NC}"
}

# Function to verify database connection
verify_connection() {
    echo -e "${YELLOW}Verifying PostgreSQL connection...${NC}"

    if PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d postgres -c '\q' 2>/dev/null; then
        echo -e "${GREEN}✓ Connection successful${NC}"
        return 0
    else
        echo -e "${RED}✗ Failed to connect to PostgreSQL${NC}"
        echo "Please check your connection parameters"
        return 1
    fi
}

# Function to show database status
show_status() {
    echo -e "\n${GREEN}=== Database Status ===${NC}"

    local idx=0
    for db_name in "${DB_NAMES[@]}"; do
        local service_dir="${SERVICE_DIRS[$idx]}"

        echo -e "\n${YELLOW}Database: $db_name${NC}"

        # Get table count
        local table_count=$(PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $db_name -tAc "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='public' AND table_type='BASE TABLE'" 2>/dev/null || echo "0")

        echo "  Tables: $table_count"

        # List tables
        if [ "$table_count" -gt 0 ]; then
            echo "  Table names:"
            PGPASSWORD=$DB_PASSWORD psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $db_name -tAc "SELECT '    - ' || tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename" 2>/dev/null
        fi

        idx=$((idx + 1))
    done
}

# Main execution
main() {
    echo -e "${YELLOW}Step 1: Verifying connection${NC}"
    if ! verify_connection; then
        exit 1
    fi

    echo -e "\n${YELLOW}Step 2: Creating databases${NC}"
    for db_name in "${DB_NAMES[@]}"; do
        create_database "$db_name"
    done

    echo -e "\n${YELLOW}Step 3: Running migrations${NC}"
    local idx=0
    for db_name in "${DB_NAMES[@]}"; do
        local service_dir="${SERVICE_DIRS[$idx]}"
        if ! run_migrations "$db_name" "$service_dir"; then
            echo -e "${RED}✗ Migration failed for $db_name${NC}"
            exit 1
        fi
        idx=$((idx + 1))
    done

    # Show final status
    show_status

    echo -e "\n${GREEN}=== Initialization Complete ===${NC}"
    echo -e "${GREEN}All databases have been created and migrations applied successfully${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Update your service environment variables to point to these databases"
    echo "  2. Start your microservices"
    echo "  3. Verify services are connecting properly"
}

# Run main function
main
