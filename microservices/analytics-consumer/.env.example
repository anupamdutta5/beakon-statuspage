# Analytics Consumer Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8083
HOST=0.0.0.0
ENVIRONMENT=development

# Security Configuration - REQUIRED in production
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRATION=24
JWT_ISSUER=statuspage-analytics-consumer

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=statuspage_analytics_consumer
DB_SSL_MODE=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=10

# Message Queue Configuration
RABBIT_MQ_URL=amqp://guest:guest@localhost:5672/
RABBIT_MQ_EXCHANGE=analytics
RABBIT_MQ_QUEUE=analytics.events
RABBIT_MQ_ROUTING_KEY=analytics.*
RABBIT_MQ_CONSUMER_TAG=analytics-consumer

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_PORT=9093
HEALTH_PORT=8084
LOG_LEVEL=info

# Processing Configuration
BATCH_SIZE=100
BATCH_TIMEOUT=5
MAX_RETRIES=3
RETRY_DELAY=1

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_MAX_REQUESTS=3