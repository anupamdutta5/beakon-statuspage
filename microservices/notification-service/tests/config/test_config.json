{
  "environment": "testing",
  "log_level": "debug",
  "timeout": "10m",
  "retry_attempts": 5,
  "retry_delay": "2s",
  "cleanup_on_exit": true,
  "parallel_tests": false,
  "coverage_report": true,
  "test_data_dir": "./testdata",
  "server": {
    "port": "8086",
    "host": "localhost",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "statuspage_notification_test",
    "user": "postgres",
    "password": "postgres",
    "ssl_mode": "disable",
    "max_connections": 10,
    "max_idle_connections": 5,
    "connection_max_lifetime": "1h"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 10,
    "min_idle_connections": 5
  },
  "notification_channels": {
    "email": {
      "enabled": true,
      "smtp_host": "smtp.gmail.com",
      "smtp_port": 587,
      "smtp_username": "test@example.com",
      "smtp_password": "test_password",
      "from_email": "noreply@example.com"
    },
    "sms": {
      "enabled": true,
      "provider": "twilio",
      "account_sid": "test_account_sid",
      "auth_token": "test_auth_token",
      "from_number": "+1234567890"
    },
    "webhook": {
      "enabled": true,
      "timeout": "30s",
      "retry_attempts": 3
    },
    "push": {
      "enabled": true,
      "fcm_server_key": "test_fcm_key",
      "apns_cert_path": "/path/to/cert.pem"
    }
  },
  "services": {
    "tenant_service": {
      "base_url": "http://localhost:8082",
      "timeout": "5s"
    },
    "user_service": {
      "base_url": "http://localhost:8081",
      "timeout": "5s"
    }
  },
  "test_scenarios": {
    "send_notification": {
      "enabled": true,
      "timeout": "5s"
    },
    "update_notification_status": {
      "enabled": true,
      "timeout": "5s"
    },
    "list_notifications": {
      "enabled": true,
      "timeout": "5s"
    },
    "create_template": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_notification_stats": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_notifications_by_type": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_notifications_by_status": {
      "enabled": true,
      "timeout": "5s"
    },
    "performance_test": {
      "enabled": true,
      "timeout": "15s",
      "bulk_operations": 30
    }
  },
  "mock_data": {
    "notifications": [
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "type": "email",
        "channel": "email",
        "recipient": "user@example.com",
        "subject": "Test Notification",
        "message": "This is a test notification",
        "priority": "normal",
        "status": "pending",
        "metadata": {
          "template": "incident_alert",
          "incident_id": "inc-123"
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "type": "sms",
        "channel": "sms",
        "recipient": "+1234567890",
        "subject": "SMS Alert",
        "message": "This is an SMS alert",
        "priority": "high",
        "status": "pending"
      },
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "type": "webhook",
        "channel": "webhook",
        "recipient": "https://webhook.example.com",
        "subject": "Webhook Notification",
        "message": "{\"event\": \"incident_created\"}",
        "priority": "normal",
        "status": "pending"
      }
    ],
    "notification_types": [
      "email",
      "sms",
      "webhook",
      "push",
      "slack",
      "teams"
    ],
    "notification_statuses": [
      "pending",
      "sent",
      "delivered",
      "failed",
      "bounced"
    ],
    "notification_priorities": [
      "low",
      "normal",
      "high",
      "urgent"
    ],
    "templates": [
      {
        "tenant_id": "test-tenant-id",
        "name": "Incident Alert",
        "type": "email",
        "subject": "Incident Alert: {{.Incident.Title}}",
        "body": "An incident has occurred: {{.Incident.Description}}",
        "variables": ["Incident.Title", "Incident.Description", "Incident.Severity"],
        "status": "active"
      },
      {
        "tenant_id": "test-tenant-id",
        "name": "Maintenance Notice",
        "type": "email",
        "subject": "Scheduled Maintenance: {{.Maintenance.Title}}",
        "body": "Scheduled maintenance: {{.Maintenance.Description}}",
        "variables": ["Maintenance.Title", "Maintenance.Description", "Maintenance.StartTime"],
        "status": "active"
      }
    ]
  }
}

