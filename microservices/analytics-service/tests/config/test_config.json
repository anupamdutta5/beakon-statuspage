{
  "environment": "testing",
  "log_level": "debug",
  "timeout": "10m",
  "retry_attempts": 5,
  "retry_delay": "2s",
  "cleanup_on_exit": true,
  "parallel_tests": false,
  "coverage_report": true,
  "test_data_dir": "./testdata",
  "server": {
    "port": "8088",
    "host": "localhost",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "120s"
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "statuspage_analytics_test",
    "user": "postgres",
    "password": "postgres",
    "ssl_mode": "disable",
    "max_connections": 10,
    "max_idle_connections": 5,
    "connection_max_lifetime": "1h"
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0,
    "pool_size": 10,
    "min_idle_connections": 5
  },
  "services": {
    "tenant_service": {
      "base_url": "http://localhost:8082",
      "timeout": "5s"
    },
    "user_service": {
      "base_url": "http://localhost:8081",
      "timeout": "5s"
    },
    "component_service": {
      "base_url": "http://localhost:8084",
      "timeout": "5s"
    }
  },
  "test_scenarios": {
    "track_event": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_analytics": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_dashboard": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_events": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_user_analytics": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_event_types": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_top_pages": {
      "enabled": true,
      "timeout": "5s"
    },
    "get_realtime_analytics": {
      "enabled": true,
      "timeout": "5s"
    },
    "export_analytics": {
      "enabled": true,
      "timeout": "10s"
    },
    "performance_test": {
      "enabled": true,
      "timeout": "15s",
      "bulk_operations": 50
    }
  },
  "mock_data": {
    "events": [
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "event_type": "page_view",
        "event_name": "status_page_viewed",
        "properties": {
          "page_url": "/status",
          "referrer": "https://google.com"
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "event_type": "click",
        "event_name": "component_clicked",
        "properties": {
          "component_id": "api-server",
          "component_status": "operational"
        }
      },
      {
        "tenant_id": "test-tenant-id",
        "user_id": "test-user-id",
        "event_type": "form_submit",
        "event_name": "contact_form_submitted",
        "properties": {
          "form_type": "contact",
          "success": true
        }
      }
    ],
    "event_types": [
      "page_view",
      "click",
      "form_submit",
      "download",
      "search",
      "navigation"
    ],
    "event_names": [
      "status_page_viewed",
      "incident_page_viewed",
      "component_clicked",
      "contact_form_submitted",
      "file_downloaded",
      "search_performed"
    ],
    "dashboard_widgets": [
      {
        "id": "overview",
        "type": "overview",
        "title": "Overview",
        "config": {
          "metrics": ["total_events", "unique_users", "page_views"]
        }
      },
      {
        "id": "page_views_chart",
        "type": "line_chart",
        "title": "Page Views Over Time",
        "config": {
          "metric": "page_views",
          "time_range": "7d"
        }
      },
      {
        "id": "top_pages",
        "type": "table",
        "title": "Top Pages",
        "config": {
          "metric": "page_views",
          "limit": 10
        }
      }
    ]
  }
}

