# Analytics Service Configuration Example
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# Service Configuration
PORT=8090
HOST=0.0.0.0
ENVIRONMENT=development
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# JWT Configuration - MUST change for production
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRATION=24h
JWT_ISSUER=statuspage-analytics-service

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_NAME=statuspage_analytics
DB_SSL_MODE=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m

# Analytics Configuration
DATA_RETENTION_DAYS=365
AGGREGATION_INTERVAL=daily
CACHE_ENABLED=true
CACHE_TTL=300
EXPORT_FORMATS=csv,json,excel
MAX_DATA_POINTS=10000
REAL_TIME_ENABLED=true

# Redis Cache (if enabled)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_POOL_SIZE=10

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9100
HEALTH_PORT=8091

# Server Timeouts
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s
GRACEFUL_SHUTDOWN_TIMEOUT=30s

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200

# Security
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true

# Tracing (if enabled)
TRACING_ENABLED=false
TRACING_SERVICE_NAME=analytics-service
TRACING_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces